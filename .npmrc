# Node version policy.
#
# `engines.node` in package.json is a floor (">=22"), not a pin, and deliberately
# so. The reproducible runtime is pinned in .nvmrc (22), which is what CI and
# the Docker build read; repeating that pin in `engines` would add no
# reproducibility on top of .nvmrc and would break `pnpm install` for anyone
# developing on a newer runtime — the machines this is built on run Node 23.
#
# The same asymmetry applies to the engine ranges our dependencies declare.
# Several of them enumerate release lines (`^20.19 || ^22.12 || >=24`) rather
# than state a minimum, so an odd-numbered Node that works perfectly well reads
# as unsupported. That should be a warning worth reading, not a wall.
engine-strict=false
